# ---------------------------------------------------------------------------
# 本地开发环境变量模板：复制成 .env 后按需修改（.env 已在 .gitignore 中，不会入库）
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# app/config.py 会在进程启动时读取项目根目录的 .env（UTF-8，override=False），
# 系统环境变量优先。
# ---------------------------------------------------------------------------

# ---------------- 密钥（必填） ----------------
# HF_TOKEN 需要与「接受模型条款」的账号一致。以下三个 gated 模型缺一个就会 403：
#   https://hf.co/pyannote/speaker-diarization-3.1
#   https://hf.co/pyannote/segmentation-3.0
#   https://hf.co/pyannote/speaker-diarization-community-1   （pyannote.audio 4.x 的 PLDA 依赖）
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------- 路径（相对路径相对项目根，不要写死 C:\ 或 /workspace） ----------------
DATA_ROOT=data
# UPLOAD_DIR=data/uploads
# AUDIO_DIR=data/audio
# OUTPUT_DIR=data/outputs

# ---------------- FFmpeg（通常不用改：装了并加进 PATH 即可） ----------------
# 未加入 PATH 时才需要显式指定，Windows 建议用正斜杠，避免 \b \t 之类被 dotenv 误解析
# FFMPEG_BIN=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_BIN=C:/ffmpeg/bin/ffprobe.exe
# FFMPEG_TIMEOUT=1800

# ---------------- ASR ----------------
# 按显存选择（峰值含词级对齐模型，约 1.2GB；分离先跑后释放，不与 ASR 叠加）：
#   4~6GB   : ASR_MODEL=medium          ASR_COMPUTE_TYPE=int8_float16  ASR_BATCH_SIZE=2
#   6~8GB   : ASR_MODEL=large-v3-turbo  ASR_COMPUTE_TYPE=int8_float16  ASR_BATCH_SIZE=4
#   8~12GB  : ASR_MODEL=large-v3-turbo  ASR_COMPUTE_TYPE=float16       ASR_BATCH_SIZE=4
#  12~16GB  : ASR_MODEL=large-v3        ASR_COMPUTE_TYPE=float16       ASR_BATCH_SIZE=8
#  16~24GB  : ASR_MODEL=large-v3        ASR_COMPUTE_TYPE=float16       ASR_BATCH_SIZE=8
#  24GB+    : ASR_MODEL=large-v3        ASR_COMPUTE_TYPE=float16       ASR_BATCH_SIZE=16
# 显存 <6GB 且必须开分离时，可设 ASR_ALIGN=0（省约 1.2GB，代价是无法按词拆段）
ASR_MODEL=large-v3-turbo
ASR_COMPUTE_TYPE=float16
ASR_BATCH_SIZE=4
ASR_LANGUAGE=auto
VAD_METHOD=silero
# 词级对齐只用于「按说话人拆段」，没有说话人标签时会自动跳过（省 1.2GB/语言）
# 1 / true = 开启对齐   0 / false = 完全关闭
ASR_ALIGN=1
# 切片时长：影响时间戳精度与失败重跑粒度，对显存峰值影响很小
CHUNK_MINUTES=10

# 模型加载联网策略：
# auto（默认）= 先联网校验；遇到网络错误（HF 504 / 代理不可达）自动切离线重试一次
# 1          = 始终离线（模型已下载到本地时启动更快）
# 0          = 始终联网
# ASR_OFFLINE=auto
# 语言投票：只用于统计主导语言（顶层 language 字段），默认不再锁定后续切片。
# 锁定会让后面出现的其他语言被强制按错误语言解码，多语种采访务必保持 0。
# ASR_LANG_MIN_SHARE=0.8
# ASR_LANG_VOTE_SAMPLES=3
# ASR_LANG_LOCK=0

# ---- 片内语言细分（多语种采访的关键）----
# Whisper 的 language 参数对整段生效：10 分钟切片里从日语切到英语时，
# 后半段会被按日语解码（假名 / 字符级拉丁字母 / 复读）。开启后先用滑窗检测语言，
# 在语言变化处把切片再切成子片，每个子片用自己的语言解码与对齐。
# ASR_LANG_SPAN=1            # 0 = 关闭，退回「整片一种语言」
# ASR_LANG_PROBE_SEC=25      # 语言探测窗口（秒）
# ASR_LANG_SPAN_MAX=300      # 单个语言子片上限（秒，同语言连续 300s 内不拆）
# ASR_LANG_SPAN_MIN=8        # 同语种子片的最短长度
# ASR_LANG_MIN_CONF=0.55     # detect_language 置信度下限，低于它交给上下文/whisper 判断
# ASR_LANG_SNAP_WINDOW=6     # 子片边界吸附到静音的半径（秒）
# ASR_LANG_MIN_CHUNK_SEC=45  # 切片短于该值不做细分
# ASR_LANG_MAX_PARTS=6       # 语言切换次数达到该值视为 BGM/噪声抖动，退回整片
#                            # （同语言被长度拆分不计入切换次数）

# ---- 重叠语音（多人同时说话）----
# pyannote 的重叠 turns 会被保留：segment 额外带 speakers=[...] 与 overlap=true。
# 文本本身无法拆分（要真正分离需要额外的声源分离模型），但总结阶段不会把
# 「两个人同时说」的内容误记到一个人头上。
# ASR_OVERLAP=1
# ASR_OVERLAP_MIN_RATIO=0.3    # 某说话人覆盖 segment 时长达该比例才算同时说话

# 切点在目标位置 ±N 秒内吸附到静音中点，避免从句子中间切开；0 = 严格等分
# CHUNK_SNAP_WINDOW=20
# SILENCE_NOISE_DB=-35
# SILENCE_MIN_SEC=0.6

# 没有说话人标签时的段落合并窗口（秒）。默认比 MERGE_GAP_SEC 小，
# 避免把所有 UNKNOWN 当成同一人、把不同人的话揉成一段。
# MERGE_GAP_SEC_NO_DIAR=0.3

# ---------------- 说话人分离 ----------------
# waveform（推荐）：自己读 16k wav 传 {"waveform","sample_rate"}，不依赖 torchcodec
# path            ：把路径交给 pyannote，需要 torchcodec 与 torch 版本严格匹配
#                  （Windows 还需要共享版 FFmpeg DLL，极易失败）
# DIAR_AUDIO_INPUT=waveform
# 已知人数时直接声明，比任何后处理都有效（新闻/访谈通常 2 人）
# DIAR_MIN_SPEAKERS=2
# DIAR_MAX_SPEAKERS=2
# 分离前裁掉首尾静音（长静音开头很常见，pyannote 对它们滑窗纯属浪费）
# DIAR_TRIM_SILENCE=1
# DIAR_TRIM_MIN_SEC=1.0
# DIAR_ENERGY_THRESHOLD=0.001
# 低于该时长/占比的「幽灵说话人」并入最近的保留说话人（占比按有效语音时长算）
# DIAR_MIN_SPEAKER_SEC=5
# DIAR_MIN_SPEAKER_SHARE=0.01
# segment 与最近说话人时间片超过该间隔就标 UNKNOWN
# MAX_SPEAKER_ATTACH_GAP=2.0
# 0 = 不缓存失败原因（每次任务都重试）；默认只缓存 403/token 这类永久错误
# DIAR_CACHE_FAILURE=1

# ---------------- 重叠语音分离（可选） ----------------
# 多人同时说话时 whisper 会输出没有词边界的粘连文本（againandagain...）。
# 开启后对「检测到重叠」的区间做声源分离，每条轨单独转录，再替换原结果。
# 需要独立的 pyannote.audio 3.3.2 环境（与主服务的 4.x 冲突，不能装在一起）：
#   双击运行 scripts\setup-separation-env.bat
# 模型是 gated，需要先用同一个 HF 账号同意两个模型的条款：
#   https://hf.co/pyannote/separation-ami-1.0
#   https://hf.co/pyannote/speech-separation-ami-1.0
SEPARATION_ENABLED=1
# SEPARATION_PYTHON=D:/projects/polyglot-media-summarizer/.venv-sep/Scripts/python.exe
# SEPARATION_MODEL=pyannote/speech-separation-ami-1.0
# 单次分离超时（秒）；首次会下载约 1.3GB 权重
# SEPARATION_TIMEOUT=600
# 短于该时长的重叠忽略（秒）；单次分离的最大片段长度（秒）
# SEPARATION_MIN_OVERLAP_SEC=0.8
# SEPARATION_MAX_CLIP_SEC=60
# 分离前释放 ASR 模型，给分离子进程腾显存（8GB 卡建议保持 1）
# SEPARATION_RELEASE_ASR=1

# Whisper 幻觉过滤阈值（BGM/静音处的复读与「感谢观看」类输出）
# HALLU_NO_SPEECH_PROB=0.6
# HALLU_AVG_LOGPROB=-1.0
# HALLU_COMPRESSION_RATIO=2.4

# Windows 上 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True 不受支持，请不要设置

# 模型缓存目录：默认放 D 盘（目录不存在会自动创建）
# 没有 D 盘就把盘符改成自己的；留空/注释掉则回落到 %USERPROFILE%\.cache
# HF_HOME 管 HuggingFace（ASR / pyannote 权重），TORCH_HOME 管 torch.hub（silero VAD 权重）
HF_HOME=D:/models/huggingface
TORCH_HOME=D:/models/torch

# HuggingFace 日志开关（app/config.py 已默认设置；想排查下载问题时可临时改成 0）
HF_HUB_DISABLE_SYMLINKS_WARNING=1
HF_HUB_DISABLE_PROGRESS_BARS=1

# ---------------- 总结（DeepSeek，会花钱） ----------------
# false（默认）：转录完成后停在 transcribed，等用户显式调用 /summarize 再计费
# true         ：转录完成后立即自动总结（旧行为）
AUTO_SUMMARIZE=false
DEEPSEEK_MODEL=deepseek-chat
SUMMARY_BLOCK_CHARS=8000
AGG_MAX_CHARS=24000
SUMMARY_MAX_TOKENS=4096
FINAL_MAX_TOKENS=8192

# ---------------- 服务行为 ----------------
MAX_UPLOAD_MB=2048
MAX_CONCURRENT_TASKS=1
TASK_RETENTION_HOURS=24
LOG_LEVEL=INFO
